# Binance API
APIKEY=your_binance_api_key
SECRET=your_binance_api_secret

# Set to true to use Binance Testnet
BINANCE_TESTNET=false

# Trading Pair
MARKET1=BONK
MARKET2=USDT

# Base Strategy
PRICE_PERCENT=0.5
BUY_ORDER_AMOUNT=50000
MIN_PRICE_TRANSACTION=1

# Bollinger Bands
BOLLINGER_BANDS_PERCENT_BUY=0.1
BOLLINGER_BANDS_PERCENT_SELL=0.5
BOLLINGER_BANDS_STOP_LOSS_ORDER=0.2

# Bollinger MA Trailing
BOLLIINGER_MA_STOP_LOSS=0.2

# RSI Filter (overlays on Bollinger strategies)
APPLY_RSI=true
RSI_SUPPORT=30
RSI_RESISTANCE=70

# Risk Management
STOP_LOSS_BOT=3
TAKE_PROFIT_BOT=3
MAX_OPEN_ORDERS=10
MAX_POSITION_PCT=30

# Execution
SLEEP_TIME=2000
SELL_ALL_ON_START=false
SELL_ALL_ON_CLOSE=true

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_ENABLED=false
EMAIL_TO=

# Data directory
DATA_DIR=./data
